---
import "@fontsource/marcellus/400.css";
import "@fontsource/manrope/400.css";
import "@fontsource/manrope/600.css";
import "@fontsource/manrope/700.css";
import "@fontsource/ibm-plex-mono/400.css";
import "../styles/global.css";

type Props = {
  title: string;
  description: string;
  path?: string;
  image?: string;
  imageAlt?: string;
  theme?: string;
  noindex?: boolean;
};

const {
  title,
  description,
  path = "/",
  image = "/assets/greenways-hero.png",
  imageAlt = "A monumental future civic rotunda connected by a luminous mosaic causeway",
  theme = "greenways",
  noindex = false
} = Astro.props;
const canonical = new URL(path, Astro.site ?? "https://greenways.ai");
const imageUrl = image.startsWith("http") ? image : new URL(image, Astro.site ?? canonical).href;
const pageTitle = title === "Greenways" ? title : `${title} · Greenways`;
const structuredData = {
  "@context": "https://schema.org",
  "@type": path.startsWith("/opensource/") && path !== "/opensource/" ? "SoftwareSourceCode" : "WebPage",
  name: pageTitle,
  description,
  url: canonical.href,
  publisher: { "@type": "Organization", name: "Greenways", url: "https://greenways.ai" }
};
---
<!doctype html>
<html lang="en" data-theme={theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#07100e" />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <title>{pageTitle}</title>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <header class="site-header">
      <a class="wordmark" href="/" aria-label="Greenways home">
        <svg viewBox="0 0 48 48" aria-hidden="true"><path d="M7 39C15 21 25 12 41 7"/><path d="M13 40c7-8 14-13 25-16"/><circle cx="13" cy="34" r="3"/><circle cx="25" cy="21" r="3"/><circle cx="39" cy="9" r="3"/></svg>
        <span>GREENWAYS</span>
      </a>
      <nav aria-label="Primary navigation">
        <a href="/#studio">Studio</a>
        <a href="/opensource/">Open source</a>
        <a href="/#principles">Principles</a>
        <a class="nav-cta" href="/#early-access">Early access</a>
      </nav>
    </header>
    <main id="content"><slot /></main>
    <footer class="site-footer">
      <div><span class="wordmark-text">GREENWAYS</span><p>Make work that outlives the tool.</p></div>
      <nav aria-label="Footer navigation">
        <a href="/opensource/">Open source</a>
        <a href="https://github.com/greenways-ai">GitHub ↗</a>
        <a href="https://hara-lang.org">Hara ↗</a>
        <a href="/privacy/">Privacy</a>
        <a href="mailto:hello@greenways.ai">hello@greenways.ai</a>
      </nav>
      <small>© 2026 Greenways Pty Ltd. Code under EPL-2.0. Greenways marks and artwork reserved.</small>
    </footer>
  </body>
</html>
