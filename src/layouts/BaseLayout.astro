---
import "@fontsource/marcellus/400.css";
import "@fontsource/manrope/400.css";
import "@fontsource/manrope/600.css";
import "@fontsource/manrope/700.css";
import "@fontsource/ibm-plex-mono/400.css";
import "@greenways-ai/visual-language/theme.css";
import MosaicLogo from "@greenways-ai/visual-language/MosaicLogo.astro";
import ThemeToggle from "@greenways-ai/visual-language/ThemeToggle.astro";
import "../styles/global.css";

type Props = {
  title: string;
  description: string;
  path?: string;
  image?: string;
  imageAlt?: string;
  theme?: string;
  noindex?: boolean;
};

const {
  title,
  description,
  path = "/",
  image = "/assets/og-greenways-whatsapp.jpg",
  imageAlt = "Greenways — Create together, beside a celestial civic rotunda",
  theme = "greenways",
  noindex = false
} = Astro.props;
const canonical = new URL(path, Astro.site ?? "https://greenways.ai");
const imageUrl = image.startsWith("http") ? image : new URL(image, Astro.site ?? canonical).href;
const pageTitle = title === "Greenways" ? title : `${title} · Greenways`;
const structuredData = {
  "@context": "https://schema.org",
  "@type": path.startsWith("/opensource/") && path !== "/opensource/" ? "SoftwareSourceCode" : "WebPage",
  name: pageTitle,
  description,
  url: canonical.href,
  publisher: { "@type": "Organization", name: "Greenways", url: "https://greenways.ai" }
};
---
<!doctype html>
<html lang="en" data-theme="light" data-theme-preference="auto" data-project={theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f2ebdd" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b1513" media="(prefers-color-scheme: dark)" />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:secure_url" content={imageUrl} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <title>{pageTitle}</title>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <script>import "@greenways-ai/visual-language/theme.js";</script>
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <header class="site-header">
      <a class="wordmark" href="/" aria-label="Greenways home">
        <MosaicLogo project="greenways" label="Greenways" />
        <span>GREENWAYS</span>
      </a>
      <nav aria-label="Primary navigation">
        <a href="/#studio">Studio</a>
        <a href="/opensource/">Open source</a>
        <a href="/#principles">Principles</a>
        <a class="nav-cta" href="/#early-access">Early access</a>
        <ThemeToggle />
      </nav>
    </header>
    <main id="content"><slot /></main>
    <footer class="site-footer">
      <div><span class="wordmark-text">GREENWAYS</span><p>Create together.</p></div>
      <nav aria-label="Footer navigation">
        <a href="/opensource/">Open source</a>
        <a href="https://github.com/greenways-ai">GitHub ↗</a>
        <a href="https://hara-lang.org">Hara ↗</a>
        <a href="/privacy/">Privacy</a>
        <a href="mailto:hello@greenways.ai">hello@greenways.ai</a>
      </nav>
      <small>© 2026 Greenways Pty Ltd. Code under EPL-2.0. Greenways marks and artwork reserved.</small>
    </footer>
  </body>
</html>
