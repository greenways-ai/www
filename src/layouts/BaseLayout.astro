---
import "@fontsource/bodoni-moda/400.css";
import "@fontsource/manrope/400.css";
import "@fontsource/manrope/600.css";
import "@fontsource/manrope/700.css";
import "@fontsource/ibm-plex-mono/400.css";
import "@greenways-ai/visual-language/typography.css";
import "@greenways-ai/visual-language/theme.css";
import SharedHeader from "@greenways-ai/visual-language/SharedHeader.astro";
import "../styles/global.css";
import "../styles/typography.css";
import "../styles/world-typography.css";

type Props = {
  title: string;
  description: string;
  path?: string;
  image?: string;
  imageAlt?: string;
  theme?: string;
  noindex?: boolean;
  bodyClass?: string;
  immersive?: boolean;
};

const {
  title,
  description,
  path = "/",
  image = "https://oss.greenways.ai/visual-language/assets/og-greenways.jpg",
  imageAlt = "Greenways — tools and open standards for building connected worlds",
  theme = "greenways",
  noindex = false,
  bodyClass = "",
  immersive = false
} = Astro.props;
const manualHeroCarousel = bodyClass.split(/\s+/).includes("manual-home-page");
const canonical = new URL(path, Astro.site ?? "https://greenways.ai");
const normalizedImage = image.replace(
  /(https:\/\/oss\.greenways\.ai\/visual-language\/assets\/og-[a-z0-9-]+)\.png$/,
  "$1.jpg"
);
const imageUrl = normalizedImage.startsWith("http")
  ? normalizedImage
  : new URL(normalizedImage, Astro.site ?? canonical).href;
const imageType = imageUrl.endsWith(".jpg") || imageUrl.endsWith(".jpeg")
  ? "image/jpeg"
  : imageUrl.endsWith(".webp")
    ? "image/webp"
    : "image/png";
const pageTitle = title === "Greenways" || title.startsWith("Greenways |")
  ? title
  : `${title} · Greenways`;
const structuredData = {
  "@context": "https://schema.org",
  "@type": path.startsWith("/opensource/") && path !== "/opensource/" ? "SoftwareSourceCode" : "WebPage",
  name: pageTitle,
  description,
  url: canonical.href,
  publisher: { "@type": "Organization", name: "Greenways", url: "https://greenways.ai" }
};
---
<!doctype html>
<html lang="en" data-theme="light" data-theme-preference="auto" data-project={theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#edf9f6" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#031315" media="(prefers-color-scheme: dark)" />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {manualHeroCarousel && <link rel="stylesheet" href="/manual-hero-carousel.css" />}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:secure_url" content={imageUrl} />
    <meta property="og:image:type" content={imageType} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <title>{pageTitle}</title>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <script>import "@greenways-ai/visual-language/theme.js";</script>
    {manualHeroCarousel && <script is:inline src="/manual-hero-carousel.js" defer></script>}
  </head>
  <body class={bodyClass || undefined}>
    <a class="skip-link" href="#content">Skip to content</a>
    {immersive ? (
      <slot name="header" />
    ) : (
      <SharedHeader
        project="greenways"
        title="Greenways"
        homeHref="/"
        searchBase=""
        nav={[
          { label: "Studio", href: "/#studio" },
          { label: "Open source", href: "/opensource/" },
          { label: "Principles", href: "/#principles" }
        ]}
        githubHref="https://github.com/greenways-ai"
        cta={{ label: "Early access", href: "/#early-access" }}
      />
    )}
    <main id="content"><slot /></main>
    {immersive ? (
      <slot name="footer" />
    ) : (
      <footer class="site-footer">
        <div><span class="wordmark-text">GREENWAYS</span><p>Create together.</p></div>
        <nav aria-label="Footer navigation">
          <a href="/opensource/">Open source</a>
          <a href="https://github.com/greenways-ai">GitHub ↗</a>
          <a href="https://hara-lang.org">Hara ↗</a>
          <a href="/privacy/">Privacy</a>
          <a href="mailto:hello@greenways.ai">hello@greenways.ai</a>
        </nav>
        <small>© 2026 Greenways Pty Ltd. Code under Apache-2.0. Greenways marks and artwork reserved.</small>
      </footer>
    )}
  </body>
</html>
