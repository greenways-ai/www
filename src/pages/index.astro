---
import SharedHeader from "@greenways-ai/visual-language/SharedHeader.astro";
import Sigil from "@greenways-ai/visual-language/Sigil.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import BetaForm from "../components/BetaForm.astro";
import "../styles/publishing-home.css";

const slides = [
  {
    title: "FIG. 01 / ESSAY",
    light: "/artwork/greenways/celestial-promenade-day.webp",
    dark: "/artwork/greenways/celestial-promenade-night.webp",
    lightMobile: "/artwork/greenways/celestial-promenade-day-mobile.webp",
    darkMobile: "/artwork/greenways/celestial-promenade-night-mobile.webp"
  },
  {
    title: "FIG. 02 / WORLD",
    light: "/artwork/greenways/peacock-garden-day.webp",
    dark: "/artwork/greenways/peacock-garden-night.webp",
    lightMobile: "/artwork/greenways/peacock-garden-day-mobile.webp",
    darkMobile: "/artwork/greenways/peacock-garden-night-mobile.webp"
  },
  {
    title: "FIG. 03 / BOOK",
    light: "https://oss.greenways.ai/visual-language/artwork/www/jeweled-archipelago-day.webp",
    dark: "https://oss.greenways.ai/visual-language/artwork/www/jeweled-archipelago-night.webp",
    lightMobile: "https://oss.greenways.ai/visual-language/artwork/www/jeweled-archipelago-day-mobile.webp",
    darkMobile: "https://oss.greenways.ai/visual-language/artwork/www/jeweled-archipelago-night-mobile.webp"
  },
  {
    title: "FIG. 04 / RESEARCH",
    light: "https://oss.greenways.ai/visual-language/artwork/www/solar-steppe-observatories-day.webp",
    dark: "https://oss.greenways.ai/visual-language/artwork/www/solar-steppe-observatories-night.webp",
    lightMobile: "https://oss.greenways.ai/visual-language/artwork/www/solar-steppe-observatories-day-mobile.webp",
    darkMobile: "https://oss.greenways.ai/visual-language/artwork/www/solar-steppe-observatories-night-mobile.webp"
  },
  {
    title: "FIG. 05 / EXHIBITION",
    light: "https://oss.greenways.ai/visual-language/artwork/www/aurora-conservatory-belt-day.webp",
    dark: "https://oss.greenways.ai/visual-language/artwork/www/aurora-conservatory-belt-night.webp",
    lightMobile: "https://oss.greenways.ai/visual-language/artwork/www/aurora-conservatory-belt-day-mobile.webp",
    darkMobile: "https://oss.greenways.ai/visual-language/artwork/www/aurora-conservatory-belt-night-mobile.webp"
  }
];

const artworkStyle = (slide: (typeof slides)[number]) =>
  `--gw-art-light:url('${slide.light}');--gw-art-dark:url('${slide.dark}');--gw-art-light-mobile:url('${slide.lightMobile}');--gw-art-dark-mobile:url('${slide.darkMobile}')`;
---

<BaseLayout
  title="Greenways | Publication system"
  description="Create documents, books and 3D worlds. Publish them to the web."
  path="/"
  image="https://oss.greenways.ai/visual-language/assets/og-greenways.jpg"
  imageAlt="Greenways publication system"
  bodyClass="manual-home-page"
  immersive={true}
>
  <SharedHeader
    slot="header"
    project="greenways"
    title="Greenways"
    homeHref="/"
    searchBase=""
    nav={[
      { label: "Use", href: "#procedure" },
      { label: "Forms", href: "#forms" },
      { label: "Layout", href: "#layout" },
      { label: "Control", href: "#control" }
    ]}
    cta={{ label: "Request access", href: "#early-access" }}
  />

  <div class="manual-home">
    <section
      class="manual-cover"
      data-world-carousel
      aria-roledescription="carousel"
      aria-label="Greenways publication examples"
      tabindex="0"
    >
      <div class="manual-cover__copy">
        <div class="manual-cover__index">
          <span>OPERATING CARD</span>
          <span>GW-01 / REV. A</span>
        </div>

        <p class="manual-label">SELF-PUBLISHING / SPATIAL</p>
        <h1>MAKE.<br />ARRANGE.<br />PUBLISH.</h1>
        <p class="manual-cover__summary">
          Documents, books and 3D worlds.<br />One workspace. Web output.
        </p>

        <dl class="manual-cover__spec">
          <div><dt>INPUT</dt><dd>TEXT / MEDIA / SPACE / CODE</dd></div>
          <div><dt>OUTPUT</dt><dd>WEB PUBLICATION</dd></div>
          <div><dt>ENGINE</dt><dd>HARA</dd></div>
        </dl>

        <div class="manual-cover__actions">
          <a class="manual-button manual-button--primary" href="#early-access">REQUEST ACCESS</a>
          <a class="manual-button" href="#procedure">READ PROCEDURE ↓</a>
        </div>
      </div>

      <div class="manual-figure">
        <div class="manual-figure__stage">
          {slides.map((slide, index) => (
            <article
              class:list={["manual-slide", { "is-active": index === 0 }]}
              data-world-slide
              data-title={slide.title}
              aria-hidden={index === 0 ? "false" : "true"}
            >
              <div
                class="manual-slide__art gw-themed-artwork"
                style={artworkStyle(slide)}
                aria-hidden="true"
              ></div>
            </article>
          ))}

          <div class="manual-figure__grid" aria-hidden="true"></div>
          <div class="manual-callout manual-callout--a" aria-hidden="true"><span>A</span> READER PATH</div>
          <div class="manual-callout manual-callout--b" aria-hidden="true"><span>B</span> MEDIA OBJECT</div>
          <div class="manual-callout manual-callout--c" aria-hidden="true"><span>C</span> VIEWPOINT</div>
        </div>

        <div class="manual-figure__controls">
          <button class="gw-control manual-figure__arrow" type="button" data-carousel-previous aria-label="Show previous figure">←</button>
          <div class="manual-figure__caption">
            <span data-carousel-count>01 / 05</span>
            <strong data-carousel-caption>FIG. 01 / ESSAY</strong>
          </div>
          <div class="manual-figure__dots" aria-label="Choose a figure">
            {slides.map((slide, index) => (
              <button
                class:list={[{ "is-active": index === 0 }]}
                type="button"
                data-carousel-dot={index}
                aria-label={`Show ${slide.title}`}
                aria-current={index === 0 ? "true" : undefined}
              ></button>
            ))}
          </div>
          <button class="gw-control manual-figure__arrow" type="button" data-carousel-next aria-label="Show next figure">→</button>
        </div>
      </div>

      <p class="manual-sr-only" aria-live="polite" data-carousel-status>
        Showing figure 1 of 5.
      </p>
    </section>

    <section id="procedure" class="manual-panel">
      <header class="manual-panel__header">
        <span class="manual-panel__number">01</span>
        <div><small>OPERATING SEQUENCE</small><h2>USE IN THREE STEPS</h2></div>
        <span class="manual-panel__code">PROC. GW-01</span>
      </header>

      <ol class="manual-steps">
        <li>
          <span class="manual-step__mark">1</span>
          <div><strong>WRITE</strong><p>Enter text, image, sound or 3D.</p></div>
        </li>
        <li>
          <span class="manual-step__mark">2</span>
          <div><strong>ARRANGE</strong><p>Place pages, rooms, objects and paths.</p></div>
        </li>
        <li>
          <span class="manual-step__mark">3</span>
          <div><strong>PUBLISH</strong><p>Release a web edition. Update as required.</p></div>
        </li>
      </ol>
    </section>

    <section id="forms" class="manual-panel">
      <header class="manual-panel__header">
        <span class="manual-panel__number">02</span>
        <div><small>OUTPUT FORMS</small><h2>SELECT PUBLICATION TYPE</h2></div>
        <span class="manual-panel__code">FORM SET / A</span>
      </header>

      <div class="manual-forms">
        <article>
          <div class="manual-form__diagram manual-form__diagram--document" aria-hidden="true"><span></span><span></span><span></span></div>
          <div class="manual-form__id">F-01</div>
          <h3>DOCUMENT</h3>
          <p>NOTES / REPORTS / MANUALS</p>
        </article>
        <article>
          <div class="manual-form__diagram manual-form__diagram--book" aria-hidden="true"><span></span><span></span><span></span></div>
          <div class="manual-form__id">F-02</div>
          <h3>BOOK</h3>
          <p>CHAPTERS / MEDIA / EDITIONS</p>
        </article>
        <article>
          <div class="manual-form__diagram manual-form__diagram--world" aria-hidden="true"><span></span><span></span><span></span></div>
          <div class="manual-form__id">F-03</div>
          <h3>WORLD</h3>
          <p>SCENES / OBJECTS / PATHS</p>
        </article>
      </div>
    </section>

    <section id="layout" class="manual-panel">
      <header class="manual-panel__header">
        <span class="manual-panel__number">03</span>
        <div><small>SYSTEM LAYOUT</small><h2>ONE WORKSPACE</h2></div>
        <span class="manual-panel__code">FIG. GW-03</span>
      </header>

      <div class="manual-schematic" aria-label="Greenways workspace diagram">
        <aside class="manual-schematic__rail manual-schematic__rail--input">
          <small>INPUT</small>
          <span>TEXT</span>
          <span>IMAGE</span>
          <span>SOUND</span>
          <span>3D</span>
        </aside>

        <figure class="manual-schematic__viewport">
          <img
            src="/artwork/greenways/peacock-garden-day.webp"
            alt="A spatial publication in the Greenways workspace"
            loading="lazy"
          />
          <figcaption>WORK AREA / MANUSCRIPT + SCENE + READER VIEW</figcaption>
          <span class="manual-schematic__point manual-schematic__point--one">1</span>
          <span class="manual-schematic__point manual-schematic__point--two">2</span>
          <span class="manual-schematic__point manual-schematic__point--three">3</span>
        </figure>

        <aside class="manual-schematic__rail manual-schematic__rail--output">
          <small>OUTPUT</small>
          <span>URL</span>
          <span>EDITION</span>
          <span>ACCESS</span>
          <span>UPDATE</span>
        </aside>

        <div class="manual-schematic__control">
          <small>CONTROL RAIL</small>
          <span>HARA</span><b>→</b><span>COMMANDS</span><b>→</b><span>EDITORS</span><b>→</b><span>AGENTS</span>
        </div>
      </div>
    </section>

    <section id="control" class="manual-panel">
      <header class="manual-panel__header">
        <span class="manual-panel__number">04</span>
        <div><small>CONTROL SYSTEM</small><h2>PROGRAM THE WORKSPACE</h2></div>
        <span class="manual-panel__code">HARA / LISP</span>
      </header>

      <div class="manual-control">
        <div class="manual-control__equation">
          <span>HARA</span><b>→</b><span>COMMANDS</span><b>→</b><span>EDITORS</span><b>→</b><span>PUBLICATION</span>
        </div>
        <div class="manual-control__notes">
          <article><small>EMACS PRINCIPLE</small><strong>EDITOR MAY BE EXTENDED.</strong></article>
          <article><small>3D PRINCIPLE</small><strong>SPACE IS PART OF THE DOCUMENT.</strong></article>
          <article><small>OPERATING RULE</small><strong>MODIFY THE WORKSPACE TO SUIT THE WORK.</strong></article>
        </div>
      </div>
    </section>

    <section id="release" class="manual-panel">
      <header class="manual-panel__header">
        <span class="manual-panel__number">05</span>
        <div><small>WEB OUTPUT</small><h2>RELEASE AN EDITION</h2></div>
        <span class="manual-panel__code">PUB. GW-05</span>
      </header>

      <div class="manual-output">
        <dl>
          <div><dt>ADDRESS</dt><dd>PROJECT.GREENWAYS.AI</dd></div>
          <div><dt>EDITION</dt><dd>01 / 02 / 03 / …</dd></div>
          <div><dt>ACCESS</dt><dd>PUBLIC / PRIVATE</dd></div>
          <div><dt>UPDATE</dt><dd>IN PLACE</dd></div>
        </dl>
        <p>THE PUBLICATION IS THE PRIMARY OBJECT.</p>
      </div>
    </section>

    <aside class="manual-foundations" aria-label="Technical foundations">
      <span>SERVICE NOTE / HARA + OPEN FOUNDATIONS</span>
      <a href="https://oss.greenways.ai/">TECHNICAL INDEX ↗</a>
    </aside>

    <BetaForm />
  </div>

  <footer slot="footer" class="manual-footer">
    <a class="manual-footer__brand" href="/" aria-label="Greenways home">
      <Sigil project="greenways" />
      <strong>Greenways</strong>
    </a>
    <p>PUBLICATION SYSTEM / GW-01 / REV. A</p>
    <nav aria-label="Footer navigation">
      <a href="#procedure">USE</a>
      <a href="#forms">FORMS</a>
      <a href="#control">CONTROL</a>
      <a href="/privacy/">PRIVACY</a>
      <a href="https://oss.greenways.ai/">TECHNICAL INDEX ↗</a>
    </nav>
    <small>© 2026 GREENWAYS PTY LTD.</small>
  </footer>
</BaseLayout>

<script>
  const carousel = document.querySelector<HTMLElement>("[data-world-carousel]");

  if (carousel) {
    const slides = Array.from(carousel.querySelectorAll<HTMLElement>("[data-world-slide]"));
    const dots = Array.from(carousel.querySelectorAll<HTMLButtonElement>("[data-carousel-dot]"));
    const previous = carousel.querySelector<HTMLButtonElement>("[data-carousel-previous]");
    const next = carousel.querySelector<HTMLButtonElement>("[data-carousel-next]");
    const count = carousel.querySelector<HTMLElement>("[data-carousel-count]");
    const caption = carousel.querySelector<HTMLElement>("[data-carousel-caption]");
    const status = carousel.querySelector<HTMLElement>("[data-carousel-status]");
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    let activeIndex = 0;
    let timer: number | undefined;

    const render = (index: number, announce = true) => {
      activeIndex = (index + slides.length) % slides.length;
      slides.forEach((slide, slideIndex) => {
        const isActive = slideIndex === activeIndex;
        slide.classList.toggle("is-active", isActive);
        slide.setAttribute("aria-hidden", String(!isActive));
      });
      dots.forEach((dot, dotIndex) => {
        const isActive = dotIndex === activeIndex;
        dot.classList.toggle("is-active", isActive);
        if (isActive) dot.setAttribute("aria-current", "true");
        else dot.removeAttribute("aria-current");
      });
      const title = slides[activeIndex]?.dataset.title ?? "FIGURE";
      if (count) count.textContent = `${String(activeIndex + 1).padStart(2, "0")} / ${String(slides.length).padStart(2, "0")}`;
      if (caption) caption.textContent = title;
      if (announce && status) status.textContent = `Showing ${title}, figure ${activeIndex + 1} of ${slides.length}.`;
    };

    const stop = () => {
      if (timer !== undefined) window.clearInterval(timer);
      timer = undefined;
    };

    const start = () => {
      stop();
      if (reducedMotion.matches) return;
      timer = window.setInterval(() => render(activeIndex + 1, false), 8000);
    };

    previous?.addEventListener("click", () => {
      render(activeIndex - 1);
      start();
    });
    next?.addEventListener("click", () => {
      render(activeIndex + 1);
      start();
    });
    dots.forEach((dot, index) => dot.addEventListener("click", () => {
      render(index);
      start();
    }));
    carousel.addEventListener("keydown", (event) => {
      if (event.key === "ArrowLeft") {
        event.preventDefault();
        render(activeIndex - 1);
        start();
      }
      if (event.key === "ArrowRight") {
        event.preventDefault();
        render(activeIndex + 1);
        start();
      }
    });
    carousel.addEventListener("pointerenter", stop);
    carousel.addEventListener("pointerleave", start);
    carousel.addEventListener("focusin", stop);
    carousel.addEventListener("focusout", start);
    reducedMotion.addEventListener?.("change", start);
    render(0, false);
    start();
  }
</script>