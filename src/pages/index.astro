---
import BaseLayout from "../layouts/BaseLayout.astro";
import CreativeLabs from "../components/CreativeLabs.astro";
import ProjectCard from "../components/ProjectCard.astro";
import BetaForm from "../components/BetaForm.astro";
import MosaicMark from "../components/MosaicMark.astro";
import ThemedArtwork from "@greenways-ai/visual-language/ThemedArtwork.astro";
import { projects } from "../data/projects";
import CosmicCatalogue from "../components/CosmicCatalogue.astro";
---
<BaseLayout title="Greenways" description="A high-trust world for creative work, built around collaborative publishing, attribution and history." path="/">
  <section class="home-hero">
    <ThemedArtwork class="home-hero__image" light="https://opensource.greenways.ai/visual-language/artwork/www/world-confluence-day.webp" dark="https://opensource.greenways.ai/visual-language/artwork/www/world-confluence-night.webp" lightMobile="https://opensource.greenways.ai/visual-language/artwork/www/world-confluence-day-mobile.webp" darkMobile="https://opensource.greenways.ai/visual-language/artwork/www/world-confluence-night-mobile.webp" lightAlt="The Greenways world confluence: a mosaic garden city of domed pavilions, rivers and wildlife by day" darkAlt="The world confluence garden city illuminated at night" position="center" />
    <div class="home-hero__veil"></div>
    <div class="home-hero__copy">
      <p class="eyebrow"><span class="status-dot"></span> A high-trust world for creative work · Public beta</p>
      <h1>Create together.</h1>
      <p>Compose music. Shape images and worlds. Work with people and machines. Greenways is building a publishing platform where contributions, approvals, attribution and history travel with the work.</p>
      <div class="hero-actions"><a class="button button--gold" href="#early-access">Join early access</a><a class="button button--ghost" href="#studio">Explore the studio <span aria-hidden="true">↓</span></a></div>
    </div>
    <div class="hero-inscription"><span>CREATE</span><i></i><span>COLLABORATE</span><i></i><span>ATTRIBUTE</span><i></i><span>PUBLISH</span></div>
  </section>

  <CreativeLabs />

  <section class="principles-section section-shell" id="principles" aria-labelledby="principles-title">
    <header class="section-heading"><div class="section-index">II · THE COMMON GROUND</div><div><p class="eyebrow">Open by construction</p><h2 id="principles-title">A world needs<br />common ground.</h2></div><p>Greenways is being designed so each place can preserve its own identity, memory and rules while remaining connected. Common formats and protocols let work travel without making the whole world depend on one machine or institution.</p></header>
    <div class="principle-orbit">
      <MosaicMark label="Open creative foundation" variant="greenways" />
      <div class="orbit-core"><strong>YOUR WORK</strong><span>portable · attributable · durable</span></div>
      <article><b>01</b><h3>Open formats</h3><p>HAL, HTA and deterministic packages are published as inspectable specifications.</p></article>
      <article><b>02</b><h3>Independent places</h3><p>Studios, personal nodes and community spaces are being designed to run separately, keep local state and choose their own rules.</p></article>
      <article><b>03</b><h3>Living connections</h3><p>Open-web protocols provide a path for those places to collaborate and exchange durable work without becoming one central system.</p></article>
      <article><b>04</b><h3>Human provenance</h3><p>Credits, approvals and lineage are first-class records, not metadata swept aside.</p></article>
    </div>
  </section>

  <section class="opensource-preview section-shell" aria-labelledby="opensource-title">
    <header class="section-heading"><div class="section-index">III · THE FOUNDATIONS</div><div><p class="eyebrow">Built in public</p><h2 id="opensource-title">Independent foundations.<br />One connected world.</h2></div><p>We are building toward places with their own language, gateway, ledger and memory—small operating systems that can remain independently governed, then connect through open protocols to form Greenways.</p></header>
    <div class="project-grid">{projects.map((project, index) => <ProjectCard project={project} index={index} />)}</div>
    <a class="wide-link" href="/opensource/"><span>Read the open-source architecture</span><span aria-hidden="true">↗</span></a>
  </section>

  <CosmicCatalogue />
  <BetaForm />
</BaseLayout>
