---
import ThemedArtwork from "@greenways-ai/visual-language/ThemedArtwork.astro";
const concepts=["celestial-promenade","peacock-garden","jeweled-sky-temple","floating-lotus-court"];
---
<section class="cosmic-catalogue section-shell" aria-labelledby="cosmic-title"><header class="section-heading"><div class="section-index">IV · THE CELESTIAL WORLD</div><div><p class="eyebrow">A peacock garden among the stars</p><h2 id="cosmic-title">Luxurious worlds.<br/>Infinite discovery.</h2></div><p>Jewel-toned skies, living architecture and celestial water form a mesmerising planetary garden built for wonder, creation and play.</p></header><div>{concepts.map((concept)=><article><ThemedArtwork light={`/artwork/greenways/${concept}-day.webp`} dark={`/artwork/greenways/${concept}-night.webp`} lightMobile={`/artwork/greenways/${concept}-day-mobile.webp`} darkMobile={`/artwork/greenways/${concept}-night-mobile.webp`} lightAlt={`${concept.replaceAll("-"," ")} by day`} darkAlt={`${concept.replaceAll("-"," ")} at night`}/><h3>{concept.replaceAll("-"," ")}</h3></article>)}</div></section>
<style>.cosmic-catalogue{padding-block:120px}.cosmic-catalogue>div{display:grid;grid-template-columns:repeat(2,1fr);gap:22px}.cosmic-catalogue article{overflow:hidden;background:var(--surface);border:1px solid var(--line)}.cosmic-catalogue article>div{aspect-ratio:16/9}.cosmic-catalogue h3{margin:0;padding:16px;font:400 1.4rem var(--display);text-transform:capitalize}@media(max-width:680px){.cosmic-catalogue{padding-block:70px}.cosmic-catalogue>div{grid-template-columns:1fr}.cosmic-catalogue article>div{aspect-ratio:3/4}}</style>
