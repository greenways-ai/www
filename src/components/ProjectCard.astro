---
import type { Project } from "../data/projects";
import MosaicMark from "./MosaicMark.astro";
const { project, index } = Astro.props as { project: Project; index: number };
---
<article class:list={["project-card", `accent-${project.accent}`]}>
  <div class="project-number">{String(index + 1).padStart(2, "0")}</div>
  <MosaicMark label={project.name} variant={project.slug} />
  <div><p class="eyebrow">{project.epithet}</p><h3>{project.name}</h3><p>{project.summary}</p></div>
  <dl><div><dt>Status</dt><dd>{project.status}</dd></div><div><dt>License</dt><dd>{project.license}</dd></div></dl>
  <a class="text-link" href={`/opensource/${project.slug}/`}>Enter the {project.motif.toLowerCase()} <span aria-hidden="true">→</span></a>
</article>
