---
type Props = { label?: string; variant?: string };
const { label = "Greenways", variant = "greenways" } = Astro.props;
const sigils: Record<string, string> = {
  greenways: "https://oss.greenways.ai/visual-language/favicons/greenways.svg?v=5.0.0",
  hestia: "/sigils/hestia.svg",
  hoplite: "/sigils/hoplite.svg",
  historian: "/sigils/historia.svg",
  historia: "/sigils/historia.svg",
  hara: "https://www.hara-lang.org/favicon.svg",
};
const sigil = sigils[variant] ?? "/sigil.svg";
---
<img
  class:list={["mosaic-sigil", `mosaic-sigil--${variant}`]}
  src={sigil}
  alt={`${label} mosaic sigil`}
  loading="lazy"
  decoding="async"
/>
